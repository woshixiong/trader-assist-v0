{
  "additionalProperties": false,
  "properties": {
    "contract_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contract Hash",
      "type": "string"
    },
    "contract_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Contract Id",
      "type": "string"
    },
    "contract_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "price_tick": {
      "pattern": "^\\+?(?=[0-9.]*[1-9])(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$",
      "title": "Price Tick",
      "type": "string"
    },
    "quantity_step": {
      "pattern": "^\\+?(?=[0-9.]*[1-9])(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$",
      "title": "Quantity Step",
      "type": "string"
    },
    "schema_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "source_metadata_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Source Metadata Version",
      "type": "string"
    },
    "source_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Snapshot Hash",
      "type": "string"
    },
    "symbol": {
      "const": "ETH",
      "default": "ETH",
      "title": "Symbol",
      "type": "string"
    },
    "venue": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Venue",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_id",
    "contract_hash",
    "contract_version",
    "venue",
    "price_tick",
    "quantity_step",
    "source_metadata_version",
    "source_snapshot_hash",
    "created_at"
  ],
  "title": "InstrumentPrecisionContractV0",
  "type": "object"
}
