{
  "$defs": {
    "ReplayStatusV0": {
      "enum": [
        "PASS",
        "FAIL"
      ],
      "title": "ReplayStatusV0",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "conflicting_event_identities": {
      "minimum": 0,
      "title": "Conflicting Event Identities",
      "type": "integer"
    },
    "corrupt_payload_count": {
      "minimum": 0,
      "title": "Corrupt Payload Count",
      "type": "integer"
    },
    "duplicate_payload_observations": {
      "minimum": 0,
      "title": "Duplicate Payload Observations",
      "type": "integer"
    },
    "entries_checked": {
      "minimum": 0,
      "title": "Entries Checked",
      "type": "integer"
    },
    "first_receive_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Receive Time"
    },
    "idempotent_event_observations": {
      "minimum": 0,
      "title": "Idempotent Event Observations",
      "type": "integer"
    },
    "last_receive_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Receive Time"
    },
    "manifest_segment_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Manifest Segment Id",
      "type": "string"
    },
    "manifest_terminal_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Terminal Hash",
      "type": "string"
    },
    "missing_payload_count": {
      "minimum": 0,
      "title": "Missing Payload Count",
      "type": "integer"
    },
    "orphan_payload_count": {
      "minimum": 0,
      "title": "Orphan Payload Count",
      "type": "integer"
    },
    "partial_manifest_count": {
      "minimum": 0,
      "title": "Partial Manifest Count",
      "type": "integer"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "replay_report_version": {
      "default": "0.1.0",
      "maxLength": 80,
      "minLength": 1,
      "title": "Replay Report Version",
      "type": "string"
    },
    "report_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Hash",
      "type": "string"
    },
    "schema_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "source_catalog_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Source Catalog Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReplayStatusV0"
    },
    "unique_payload_blobs": {
      "minimum": 0,
      "title": "Unique Payload Blobs",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "manifest_segment_id",
    "source_catalog_version",
    "entries_checked",
    "unique_payload_blobs",
    "duplicate_payload_observations",
    "idempotent_event_observations",
    "conflicting_event_identities",
    "missing_payload_count",
    "corrupt_payload_count",
    "orphan_payload_count",
    "partial_manifest_count",
    "manifest_terminal_hash",
    "status",
    "reason_codes",
    "report_hash"
  ],
  "title": "BronzeReplayReportV0",
  "type": "object"
}
