{
  "$defs": {
    "DirectionV0": {
      "enum": [
        "LONG",
        "SHORT"
      ],
      "title": "DirectionV0",
      "type": "string"
    },
    "OrderPackageV0": {
      "additionalProperties": false,
      "properties": {
        "cancellation_policy_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cancellation Policy Hash",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/DirectionV0"
        },
        "emergency_reduce_only_policy_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Emergency Reduce Only Policy Hash",
          "type": "string"
        },
        "limit_price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Price"
        },
        "max_slippage_bps": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Max Slippage Bps"
        },
        "order_package_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Order Package Hash",
          "type": "string"
        },
        "order_package_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Order Package Id",
          "type": "string"
        },
        "order_type": {
          "$ref": "#/$defs/OrderTypeV0"
        },
        "quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "reduce_only": {
          "title": "Reduce Only",
          "type": "boolean"
        },
        "schema_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "stop_policy_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Stop Policy Hash",
          "type": "string"
        },
        "symbol": {
          "const": "ETH",
          "default": "ETH",
          "title": "Symbol",
          "type": "string"
        },
        "take_profit_policy_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Take Profit Policy Hash",
          "type": "string"
        },
        "time_in_force": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Time In Force",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "order_package_id",
        "order_package_hash",
        "direction",
        "order_type",
        "quantity",
        "reduce_only",
        "time_in_force",
        "max_slippage_bps",
        "valid_until",
        "stop_policy_hash",
        "take_profit_policy_hash",
        "cancellation_policy_hash",
        "emergency_reduce_only_policy_hash"
      ],
      "title": "OrderPackageV0",
      "type": "object"
    },
    "OrderTypeV0": {
      "enum": [
        "LIMIT",
        "MARKET",
        "TRIGGER"
      ],
      "title": "OrderTypeV0",
      "type": "string"
    },
    "PlaybookIdV0": {
      "enum": [
        "LQS-FR",
        "BRK-AR",
        "TRD-PB",
        "BAL-RV",
        "MACRO-RP"
      ],
      "title": "PlaybookIdV0",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "account_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Account Snapshot Hash",
      "type": "string"
    },
    "candidate_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Hash",
      "type": "string"
    },
    "candidate_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Candidate Id",
      "type": "string"
    },
    "context_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Snapshot Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "invalidation_codes": {
      "items": {
        "type": "string"
      },
      "title": "Invalidation Codes",
      "type": "array"
    },
    "market_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Market Snapshot Hash",
      "type": "string"
    },
    "order_package": {
      "$ref": "#/$defs/OrderPackageV0"
    },
    "parameter_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Parameter Version",
      "type": "string"
    },
    "playbook_id": {
      "$ref": "#/$defs/PlaybookIdV0"
    },
    "proposal_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Hash",
      "type": "string"
    },
    "proposal_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Proposal Id",
      "type": "string"
    },
    "recommendation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Recommendation Hash",
      "type": "string"
    },
    "recommendation_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Recommendation Id",
      "type": "string"
    },
    "risk_policy_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Risk Policy Version",
      "type": "strring"
    },
    "schema_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "strategy_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Strategy Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "proposal_id",
    "proposal_hash",
    "candidate_id",
    "candidate_hash",
    "recommendation_id",
    "recommendation_hash",
    "playbook_id",
    "strategy_version",
    "parameter_version",
    "risk_policy_version",
    "market_snapshot_hash",
    "account_snapshot_hash",
    "context_snapshot_hash",
    "order_package",
    "created_at",
    "expires_at",
    "invalidation_codes"
  ],
  "title": "ProposalV0",
  "type": "object"
}
