{
  "$defs": {
    "DirectionV0": {
      "enum": [
        "LONG",
        "SHORT"
      ],
      "title": "DirectionV0",
      "type": "string"
    },
    "InstrumentPrecisionContractV0": {
      "additionalProperties": false,
      "properties": {
        "contract_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contract Hash",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Contract Id",
          "type": "string"
        },
        "contract_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Contract Version",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "price_tick": {
          "pattern": "^\\+?(?=[0-9.]*[1-9])(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$",
          "title": "Price Tick",
          "type": "string"
        },
        "quantity_step": {
          "pattern": "^\\+?(?=[0-9.]*[1-9])(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$",
          "title": "Quantity Step",
          "type": "string"
        },
        "schema_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "source_metadata_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Source Metadata Version",
          "type": "string"
        },
        "source_snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Snapshot Hash",
          "type": "string"
        },
        "symbol": {
          "const": "ETH",
          "default": "ETH",
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "contract_id",
        "contract_hash",
        "contract_version",
        "venue",
        "price_tick",
        "quantity_step",
        "source_metadata_version",
        "source_snapshot_hash",
        "created_at"
      ],
      "title": "InstrumentPrecisionContractV0",
      "type": "object"
    },
    "OrderTypeV0": {
      "enum": [
        "LIMIT",
        "MARKET",
        "TRIGGER"
      ],
      "title": "OrderTypeV0",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cancellation_policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cancellation Policy Hash",
      "type": "string"
    },
    "direction": {
      "$ref": "#/$defs/DirectionV0"
    },
    "emergency_reduce_only_policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Emergency Reduce Only Policy Hash",
      "type": "string"
    },
    "instrument_precision": {
      "$ref": "#/$defs/InstrumentPrecisionContractV0"
    },
    "limit_price": {
      "anyOf": [
        {
          "pattern": "^\\+?(?=[0-9.]*[1-9])(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limit Price"
    },
    "max_slippage_bps": {
      "pattern": "^\\+?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$",
      "title": "Max Slippage Bps",
      "type": "string"
    },
    "order_package_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Order Package Hash",
      "type": "string"
    },
    "order_package_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Order Package Id",
      "type": "string"
    },
    "order_type": {
      "$ref": "#/$defs/OrderTypeV0"
    },
    "quantity": {
      "pattern": "^\\+?(?=[0-9.]*[1-9])(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$",
      "title": "Quantity",
      "type": "string"
    },
    "reduce_only": {
      "title": "Reduce Only",
      "type": "boolean"
    },
    "schema_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "stop_policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Stop Policy Hash",
      "type": "string"
    },
    "symbol": {
      "const": "ETH",
      "default": "ETH",
      "title": "Symbol",
      "type": "string"
    },
    "take_profit_policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Take Profit Policy Hash",
      "type": "string"
    },
    "time_in_force": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Time In Force",
      "type": "string"
    },
    "valid_until": {
      "format": "date-time",
      "title": "Valid Until",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "order_package_id",
    "order_package_hash",
    "instrument_precision",
    "direction",
    "order_type",
    "quantity",
    "reduce_only",
    "time_in_force",
    "max_slippage_bps",
    "valid_until",
    "stop_policy_hash",
    "take_profit_policy_hash",
    "cancellation_policy_hash",
    "emergency_reduce_only_policy_hash"
  ],
  "title": "OrderPackageV0",
  "type": "object"
}
