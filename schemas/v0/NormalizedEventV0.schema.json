{
  "$defs": {
    "EventTypeV0": {
      "enum": [
        "TradeEventV0",
        "BboEventV0",
        "BookSnapshotEventV0",
        "BookDeltaEventV0",
        "CandleEventV0",
        "AssetContextEventV0",
        "AccountStateEventV0",
        "PositionEventV0",
        "OpenOrderEventV0",
        "OrderUpdateEventV0",
        "FillEventV0",
        "FundingEventV0",
        "LedgerEventV0",
        "MacroEventV0",
        "NewsEventV0",
        "SocialEventV0",
        "LiquidationContextEventV0",
        "LargeFlowEventV0",
        "DataHealthEventV0"
