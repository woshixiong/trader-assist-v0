#!/usr/bin/env python3
"""Read the bounded First Launch status snapshot without opening a database."""

from __future__ import annotations

import json
import re
import subprocess
import sys
from collections.abc import Callable
from dataclasses import dataclass
from datetime import UTC, datetime
from pathlib import Path
from typing import Any, Final

FRESHNESS_THRESHOLD_SECONDS: Final[float] = 15.0
MAX_FUTURE_CLOCK_SKEW_SECONDS: Final[float] = 5.0
_SERVICE: Final[str] = "trader-assist-v0-public.service"
_SNAPSHOT_PATH: Final[Path] = Path("/run/trader-assist-v0/status.json")
_EXPECTED_KEYS: Final[frozenset[str]] = frozenset(
    {"pid", "session_id", "state", "last_active_context_at", "mode", "scope"}
)
_RUNTIME_STATES: Final[frozenset[str]] = frozenset(
    {"STARTING", "WARMING", "READY", "DEGRADED", "NOT_READY", "DISCONNECTED", "STOPPING", "STOPPED"}
)
_SESSION_ID_RE: Final[re.Pattern[str]] = re.compile(r"^[0-9a-f]{32}$")
_POSITIVE_INTEGER_RE: Final[re.Pattern[str]] = re.compile(r"^[1-9][0-9]*$")


@dataclass(frozen=True)
class StatusClassification:
    output: str
    exit_code: int


class SnapshotError(ValueError):
    def __init__(self, reason: str) -> None:
        super().__init__(reason)
        self.reason = reason


SystemctlRunner = Callable[[], str]


def _unknown(reason: str) -> StatusClassification:
    return StatusClassification(f"STATUS_UNKNOWN | {reason} | IGNORE_SYSTEM_SIGNALS", 2)


def _not_ready(reason: str) -> StatusClassification:
    return StatusClassification(f"NOT_READY | {reason} | IGNORE_SYSTEM_SIGNALS", 1)


def _systemctl_show() -> str:
    completed = subprocess.run(
        [
            "systemctl",
            "show",
            _SERVICE,
            "--no-pager",
            "--property=ActiveState",
            "--property=MainPID",
        ],
        check=False,
        capture_output=True,
        text=True,
        timeout=5.0,
    )
    if completed.returncode != 0:
        raise RuntimeError("systemctl failed")
    return completed.stdout


def _service_properties(output: str) -> tuple[str, int]:
    values: dict[str, str] = {}
    for line in output.splitlines():
        key, separator, value = line.partition("=")
        if separator and key in {"ActiveState", "MainPID"}:
            if key in values:
                raise SnapshotError("CHECK_FAILED")
            values[key] = value
    if set(values) != {"ActiveState", "MainPID"}:
        raise SnapshotError("CHECK_FAILED")
    active_state = values["ActiveState"]
    if active_state != "active":
        return active_state, 0
    main_pid = values["MainPID"]
    if not _POSITIVE_INTEGER_RE.fullmatch(main_pid):
        raise SnapshotError("INVALID_MAIN_PID")
    return active_state, int(main_pid)


def _reject_duplicate_keys(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise SnapshotError("STATE_MALFORMED")
        result[key] = value
    return result


def _reject_non_finite(_value: str) -> None:
    raise SnapshotError("STATE_MALFORMED")


def _parse_timestamp(value: str) -> datetime:
    if "T" not in value:
        raise SnapshotError("STATE_INVALID")
    try:
        parsed = datetime.fromisoformat(value)
    except ValueError as exc:
        raise SnapshotError("STATE_INVALID") from exc
    if parsed.tzinfo is None or parsed.utcoffset() != UTC.utcoffset(None):
        raise SnapshotError("STATE_INVALID")
    return parsed.astimezone(UTC)


def _read_snapshot(path: Path) -> dict[str, Any]:
    try:
        raw = path.read_text(encoding="utf-8")
    except FileNotFoundError as exc:
        raise SnapshotError("STATE_MISSING") from exc
    except OSError as exc:
        raise SnapshotError("STATE_UNREADABLE") from exc
    try:
        snapshot = json.loads(
            raw,
            object_pairs_hook=_reject_duplicate_keys,
            parse_constant=_reject_non_finite,
        )
    except (json.JSONDecodeError, UnicodeDecodeError) as exc:
        raise SnapshotError("STATE_MALFORMED") from exc
    if type(snapshot) is not dict:
        raise SnapshotError("STATE_MALFORMED")
    if set(snapshot) != _EXPECTED_KEYS:
        if not _EXPECTED_KEYS.issubset(snapshot):
            raise SnapshotError("STATE_MISSING")
        raise SnapshotError("STATE_INVALID")
    return snapshot


def _validate_snapshot(snapshot: dict[str, Any], main_pid: int) -> tuple[str, datetime | None]:
    pid = snapshot["pid"]
    if type(pid) is not int or pid <= 0:
        raise SnapshotError("STATE_INVALID")
    if pid != main_pid:
        raise SnapshotError("PID_MISMATCH")
    session_id = snapshot["session_id"]
    if type(session_id) is not str or _SESSION_ID_RE.fullmatch(session_id) is None:
        raise SnapshotError("SESSION_INVALID")
    state = snapshot["state"]
    if type(state) is not str or state not in _RUNTIME_STATES:
        raise SnapshotError("STATE_INVALID")
    mode = snapshot["mode"]
    if mode != "RESTRICTED_PUBLIC_LIVE_SHADOW":
        raise SnapshotError("MODE_MISMATCH")
    scope = snapshot["scope"]
    if scope != "ETH_ONLY":
        raise SnapshotError("SCOPE_MISMATCH")
    context_timestamp = snapshot["last_active_context_at"]
    if context_timestamp is not None and type(context_timestamp) is not str:
        raise SnapshotError("STATE_INVALID")
    parsed_timestamp = None if context_timestamp is None else _parse_timestamp(context_timestamp)
    return state, parsed_timestamp


def classify(
    *,
    snapshot_path: Path = _SNAPSHOT_PATH,
    systemctl_runner: SystemctlRunner = _systemctl_show,
    now: datetime | None = None,
) -> StatusClassification:
    """Classify the service from systemd and the strict local snapshot only."""
    try:
        active_state, main_pid = _service_properties(systemctl_runner())
    except SnapshotError as exc:
        return _unknown(exc.reason)
    except Exception:
        return _unknown("CHECK_FAILED")
    if active_state != "active":
        return _not_ready("SERVICE_INACTIVE")
    try:
        state, context_timestamp = _validate_snapshot(_read_snapshot(snapshot_path), main_pid)
    except SnapshotError as exc:
        return _unknown(exc.reason)
    if context_timestamp is not None:
        current_time = datetime.now(tz=UTC) if now is None else now
        if (
            type(current_time) is not datetime
            or current_time.tzinfo is None
            or current_time.utcoffset() != UTC.utcoffset(None)
        ):
            return _unknown("CHECK_FAILED")
        age = (current_time.astimezone(UTC) - context_timestamp).total_seconds()
        if age < -MAX_FUTURE_CLOCK_SKEW_SECONDS:
            return _unknown("FUTURE_TIMESTAMP")
    else:
        age = 0.0
    if state != "READY":
        return _not_ready(f"RUNTIME_{state}")
    if context_timestamp is None:
        return _unknown("CONTEXT_TIMESTAMP_MISSING")
    effective_age = max(age, 0.0)
    if effective_age > FRESHNESS_THRESHOLD_SECONDS:
        return _not_ready("DATA_STALE")
    age_text = f"{effective_age:.1f}".rstrip("0").rstrip(".")
    return StatusClassification(
        f"READY | CONTEXT_AGE={age_text}s | SIGNALS_MAY_BE_CONSIDERED", 0
    )


def main() -> int:
    result = classify()
    print(result.output)
    return result.exit_code


if __name__ == "__main__":
    raise SystemExit(main())
