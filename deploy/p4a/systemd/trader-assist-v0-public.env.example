# TraderAssist V0 Restricted Public Runtime Environment
# =====================================================
# This file is a placeholder example.  Real values MUST be supplied outside
# Git by the operator.  Copying this file unchanged MUST fail closed.

# Activation flag (must be "1" to enable)
TRADER_ASSIST_V0_ENABLE=0

# Runtime mode (must be exactly "RESTRICTED_PUBLIC_LIVE_SHADOW")
TRADER_ASSIST_V0_MODE=DISABLED

# Path to the SQLite database file
TRADER_ASSIST_V0_DATABASE_PATH=/var/lib/trader-assist-v0/runtime.db

# Path to the reviewed risk configuration JSON file
TRADER_ASSIST_V0_RISK_CONFIGURATION_PATH=/etc/trader-assist-v0/risk-configuration.json

# HTTPS webhook URL for notification delivery
TRADER_ASSIST_V0_WEBHOOK_URL=PLACEHOLDER_DISABLED

# Webhook delivery timeout in seconds
TRADER_ASSIST_V0_WEBHOOK_TIMEOUT_SECONDS=10

# WebSocket subscription acknowledgement timeout in seconds
TRADER_ASSIST_V0_ACKNOWLEDGEMENT_TIMEOUT_SECONDS=30

# Bounded session timeout in seconds
TRADER_ASSIST_V0_SESSION_TIMEOUT_SECONDS=21600

# PYTHONPATH must NOT be defined or overridden in this file.  The production
# wrapper forces PYTHONPATH=/opt/trader-assist-v0/src so trader_assist_v0
# imports exclusively from the approved source tree.  Setting PYTHONPATH here
# would be ignored by the wrapper's explicit export and is prohibited.

# AUTHENTICATED_WEBHOOK_HEADER_SUPPORT:
# DEFERRED_PENDING_SEPARATELY_AUTHORIZED_SECURE_SECRET_INGRESS