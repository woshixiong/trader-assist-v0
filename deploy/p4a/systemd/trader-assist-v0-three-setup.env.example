# Default-off Three Setup Shadow Release configuration. Real values are supplied outside Git.
TRADER_ASSIST_V0_THREE_SETUP_ENABLE=0
TRADER_ASSIST_V0_THREE_SETUP_MODE=DISABLED
TRADER_ASSIST_V0_THREE_SETUP_CONFIG_PATH=/etc/trader-assist-v0/three-setup-shadow.json
# The notification credential is only supplied via systemd LoadCredential; never put it here.
